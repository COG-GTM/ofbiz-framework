<services xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/services.xsd">
    <description>Order Ship Readiness Services</description>
    <vendor>OFBiz</vendor>
    <version>1.0</version>

    <service name="getOrderShipReadiness" engine="groovy" auth="true" export="true" action="GET"
            location="component://order/src/main/groovy/org/apache/ofbiz/order/order/OrderShipReadinessServices.groovy" invoke="getOrderShipReadiness">
        <description>Read-only: gets the order status and, for each order line not cancelled, whether there is enough inventory to ship it</description>
        <required-permissions join-type="AND">
            <check-permission permission="ORDERMGR" action="_VIEW"/>
        </required-permissions>
        <attribute name="orderId" type="String" mode="INOUT" optional="false">
            <type-validate>
                <fail-property resource="OrderErrorUiLabels" property="OrderRequiredFieldMissingOrderId"/>
            </type-validate>
        </attribute>
        <attribute name="externalId" type="String" mode="OUT" optional="true"/>
        <attribute name="statusId" type="String" mode="OUT" optional="false"/>
        <attribute name="orderItems" type="List" mode="OUT" optional="false"/>
    </service>
</services>
