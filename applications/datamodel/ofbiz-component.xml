<ofbiz-component name="datamodel"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="https://ofbiz.apache.org/dtds/ofbiz-component.xsd">
    <resource-loader name="main" type="component"/>

    <!--
    The entity models and seed/demo/seed-initial data that used to be registered
    here have been split into the owning application components (party, securityext,
    content, workeffort, product, manufacturing, accounting, humanres, order,
    marketing, commonext). Each owning component now registers its own
    *-entitymodel.xml and *SeedData/*DemoData/*SeedInitialData files via the
    entity-resource pattern. This component is intentionally left with no
    entity-resource registrations; it remains registered in
    applications/component-load.xml to preserve component load order.
    -->

</ofbiz-component>
